{
    "name": "Existing Dockerfile",
    "build": {
        // Sets the run context to one level up instead of the .devcontainer folder.
        "context": "..",
        "dockerfile": "../Dockerfile"
    },
    "remoteUser": "ros",
    "runArgs": [
        "--net=host",
        "-e", "DISPLAY=:0",
        "-v", "/tmp/.X11-unix:/tmp/.X11-unix"
    ],
    "containerEnv": {
        "DISPLAY": ":0",
        "QT_X11_NO_MITSHM": "1"
    }
}
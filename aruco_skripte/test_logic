import cv2
from aruco_erkennung import ArucoErkennung

erkennung = ArucoErkennung()

kamera = cv2.VideoCapture(0)
for i in range(10):
    ok, bild = kamera.read()
kamera.release()

if not ok:
    print("Kein Bild bekommen")
    raise SystemExit(1)

grau = cv2.cvtColor(bild, cv2.COLOR_BGR2GRAY)
ergebnisse = erkennung.erkenne(grau)

if not ergebnisse:
    print("Marker NICHT erkannt")
for m in ergebnisse:
    print(f"ID {m['id']}: Abstand {m['abstand'] * 100:.1f} cm, "
          f"Tiefe {m['tiefe'] * 100:.1f} cm, Winkel {m['winkel']:.1f} Grad")
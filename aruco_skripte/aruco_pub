import cv2
import rclpy
from rclpy.node import Node
from std_msgs.msg import Bool, Float32MultiArray

from aruco_erkennung import ArucoErkennung


class ArucoNode(Node):
    def __init__(self):
        super().__init__("aruco_node")
        self.pub_erkannt = self.create_publisher(Bool, "/aruco/erkannt", 10)
        self.pub_messung = self.create_publisher(Float32MultiArray, "/aruco/messung", 10)

        self.erkennung = ArucoErkennung()
        self.kamera = cv2.VideoCapture(0)
        self.timer = self.create_timer(0.2, self.pruefe_bild)

    def pruefe_bild(self):
        ok, bild = self.kamera.read()
        if not ok:
            self.get_logger().warn("Kein Bild bekommen")
            return

        grau = cv2.cvtColor(bild, cv2.COLOR_BGR2GRAY)
        ergebnisse = self.erkennung.erkenne(grau)

        erkannt = Bool()
        erkannt.data = len(ergebnisse) > 0
        self.pub_erkannt.publish(erkannt)

        for m in ergebnisse:
            messung = Float32MultiArray()
            messung.data = [float(m["id"]), m["abstand"], m["winkel"]]
            self.pub_messung.publish(messung)


def main():
    rclpy.init()
    node = ArucoNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    node.kamera.release()
    node.destroy_node()
    if rclpy.ok():
        rclpy.shutdown()


if __name__ == "__main__":
    main()